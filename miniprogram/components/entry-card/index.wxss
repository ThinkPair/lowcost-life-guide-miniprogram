.entry-card{background:#FFFDF9;border:1rpx solid #E8DDC9;border-radius:22rpx;padding:25rpx 27rpx;margin-bottom:18rpx;color:#29241F;line-height:1.65;box-sizing:border-box;box-shadow:0 6rpx 16rpx rgba(76,49,23,.035)}.pressed{background:#FFF2E2}.entry-top{display:flex;justify-content:space-between;align-items:center;gap:14rpx}.entry-chapter{font-size:22rpx;color:#886C53;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.entry-arrow{font-size:25rpx;color:#B56124;background:#FAEEDD;border-radius:50%;width:43rpx;height:43rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.entry-title{font-size:32rpx;font-weight:600;line-height:1.5;margin-top:9rpx;letter-spacing:-.4rpx}.entry-summary{font-size:26rpx;color:#75695D;line-height:1.8;margin-top:12rpx;white-space:pre-wrap}.entry-bottom{display:flex;align-items:center;gap:14rpx;margin-top:21rpx;padding-top:18rpx;border-top:1rpx solid #F1E9DF;flex-wrap:wrap;font-size:21rpx;line-height:1.5}.entry-cost{color:#A74C13;background:#FFF0DE;border-radius:8rpx;padding:6rpx 13rpx;font-weight:500}.entry-evidence{color:#75695D}.entry-note{color:#75695D}
.entry-summary-label{font-size:21rpx;color:#98714F;margin-top:15rpx}.entry-summary{margin-top:4rpx}.entry-note{font-size:22rpx;margin-top:14rpx;color:#8B521F}
