      },
      {
        "pagePath": "pages/saved/index",
        "text": "收藏",
        "iconPath": "assets/saved.png",
        "selectedIconPath": "assets/saved-active.png"
      }
    ]
  },
  "usingComponents": {
    "entry-card": "/components/entry-card/index"
  },
  "sitemapLocation": "sitemap.json",
