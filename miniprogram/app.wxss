page{background:#FAF6EF;color:#29241F;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.65}
view,text,input,button{box-sizing:border-box}button{width:auto!important;min-width:0;margin:0!important;font-family:inherit;font-size:28rpx;line-height:1.5;font-weight:400;background:none;color:inherit;border-radius:0;padding:0}button::after{border:none}button[disabled]{color:#9B9288}
.page{padding:26rpx 32rpx 48rpx}.eyebrow{font-size:22rpx;letter-spacing:1rpx;color:#986744;font-weight:500}.page-title{font-size:44rpx;font-weight:650;letter-spacing:-1rpx;line-height:1.4;margin-top:10rpx}.muted{color:#756B60}.caption{font-size:24rpx;color:#756B60}.section-head{display:flex;align-items:center;justify-content:space-between;margin:32rpx 0 18rpx;gap:16rpx}.section-title{font-size:33rpx;font-weight:650;letter-spacing:-.4rpx}.text-link{font-size:24rpx;color:#A54A13;padding:10rpx 0 10rpx 16rpx;min-height:64rpx;display:flex;align-items:center;white-space:nowrap}
.pill{display:inline-block;padding:7rpx 16rpx;border:1rpx solid #F0D2B5;background:#FFF0DE;border-radius:10rpx;font-size:23rpx;color:#9E430D;line-height:1.5}.search-box{display:flex;align-items:center;border:1rpx solid #E8DDC9;border-radius:20rpx;background:#FFFDF9;min-height:94rpx;padding:0 26rpx;box-shadow:0 5rpx 14rpx rgba(74,48,23,.025)}.search-box input{flex:1;min-width:0;width:0;height:92rpx;font-size:28rpx;color:#29241F}.search-glyph{width:26rpx;height:26rpx;border:2.5rpx solid #9D826B;border-radius:50%;margin-right:24rpx;position:relative;flex-shrink:0}.search-glyph:after{content:"";position:absolute;width:12rpx;height:2.5rpx;background:#9D826B;right:-9rpx;bottom:-4rpx;transform:rotate(45deg)}.search-clear{padding:12rpx 0 12rpx 20rpx;color:#AE4B10;font-size:25rpx;min-height:72rpx;display:flex;align-items:center;font-weight:500}
.primary-button{background:#C2530C;color:#FFFFFF;padding:23rpx 28rpx;border-radius:18rpx;text-align:center;font-weight:600;min-height:90rpx;box-shadow:0 7rpx 16rpx rgba(194,83,12,.12)}.secondary-button{border:1rpx solid #E8DDC9;background:#FFFDF9;color:#8B4A22;padding:22rpx 28rpx;border-radius:18rpx;text-align:center;min-height:88rpx}.empty{padding:65rpx 28rpx;text-align:center}.empty-symbol{font-size:70rpx;color:#C97C46;line-height:1.2}.empty-title{font-size:32rpx;font-weight:600;margin-top:24rpx}.empty-note{font-size:26rpx;color:#756B60;margin:14rpx 0 30rpx;line-height:1.8}.warning{background:#FFF1DE;border:1rpx solid #E9D2B0;border-radius:16rpx;padding:21rpx 24rpx;font-size:25rpx;color:#80541E;margin:18rpx 0}.bottom-note{text-align:center;font-size:22rpx;color:#81766A;margin:34rpx 0 10rpx;line-height:1.8}.rule{height:1rpx;background:#E8DDC9;margin:30rpx 0}.list-count{font-size:24rpx;color:#756B60}.spacer{height:14rpx}.group-item{min-width:0;width:100%!important}.share-button{width:152rpx!important}.grade{width:68rpx!important}.fold-heading{width:100%!important}