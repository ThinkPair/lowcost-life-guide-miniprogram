.home{padding-top:16rpx}.home-mast{display:flex;justify-content:space-between;align-items:center;margin-bottom:19rpx;min-height:56rpx}.home-note{display:flex;align-items:center;gap:12rpx;font-size:23rpx;color:#746656}.brand-mark{display:flex;gap:4rpx;align-items:flex-end;transform:rotate(-8deg)}.brand-mark view{width:5rpx;height:14rpx;background:#C2530C;border-radius:3rpx}.brand-mark view:nth-child(2){height:22rpx}.brand-mark view:nth-child(3){height:29rpx}.about-link{font-size:23rpx;color:#856A53;min-height:56rpx;display:flex;align-items:center;gap:10rpx}.about-link text{font-size:32rpx}
.hero{position:relative;overflow:hidden;background:linear-gradient(112deg,#FFF0DF 0%,#FBE5C8 100%);border:1rpx solid #F0DAC0;border-radius:28rpx;padding:30rpx 30rpx 28rpx;min-height:332rpx}.hero-copy{position:relative;z-index:2;width:74%}.hero-tag{font-size:22rpx;color:#946844;letter-spacing:1rpx}.hero-title{font-size:49rpx;font-weight:700;letter-spacing:-1rpx;line-height:1.35;margin-top:13rpx;color:#2D251E}.hero-title view{color:#AA450B}.hero-desc{font-size:24rpx;color:#795E47;margin-top:12rpx;white-space:nowrap}.hero-action{display:inline-flex;align-items:center;justify-content:center;gap:27rpx;background:#C2530C;color:#FFFFFF;border-radius:14rpx;padding:15rpx 23rpx;font-size:24rpx;font-weight:550;min-height:68rpx;margin-top:23rpx!important;box-shadow:0 7rpx 16rpx rgba(166,66,7,.16)}.hero-action text{font-size:29rpx;line-height:1}
.hero-art{position:absolute;right:17rpx;top:65rpx;width:198rpx;height:252rpx}.art-ring{position:absolute;width:191rpx;height:191rpx;border-radius:50%;background:rgba(241,189,124,.28);right:-12rpx;top:27rpx}.art-note{position:absolute;width:129rpx;height:167rpx;border-radius:17rpx}.note-back{background:#D88945;transform:rotate(17deg);right:21rpx;top:37rpx;box-shadow:0 9rpx 16rpx rgba(136,78,31,.07)}.note-front{background:#FFFDF9;transform:rotate(-9deg);right:43rpx;top:21rpx;border:1rpx solid #EACFB1;padding:29rpx 20rpx 15rpx;box-shadow:0 13rpx 24rpx rgba(134,81,37,.1)}.note-bookmark{position:absolute;right:19rpx;top:0;width:19rpx;height:34rpx;background:#C2530C;border-radius:0 0 5rpx 5rpx}.note-check{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;background:#FFE7CB;color:#B8520D;border-radius:50%;font-size:28rpx;font-weight:600;line-height:1}.note-line{height:5rpx;background:#E8DDD0;border-radius:3rpx;width:71rpx;margin-top:17rpx}.note-line.short{width:52rpx;margin-top:9rpx}.note-label{font-size:15rpx;color:#9D7958;margin-top:14rpx;letter-spacing:2rpx}.art-spark{position:absolute;right:2rpx;top:-10rpx;font-size:41rpx;color:#C8792D}.art-dot{position:absolute;left:10rpx;bottom:20rpx;width:13rpx;height:13rpx;background:#E0A564;border-radius:50%}
.guide-meta{display:flex;align-items:center;gap:17rpx;padding:20rpx 4rpx 23rpx;font-size:21rpx;color:#7D6F60;white-space:nowrap}.meta-number{font-size:25rpx;font-weight:650;color:#514133;margin-right:4rpx}.meta-divider{width:1rpx;height:22rpx;background:#E3D5C4}.meta-source{margin-left:auto;font-size:20rpx;color:#7D6F60}.quick-queries{display:flex;align-items:center;gap:14rpx;margin:16rpx 0 22rpx}.quick-label{font-size:22rpx;color:#88786A;margin-right:3rpx}.quick-queries button{font-size:23rpx;color:#82634B;min-height:52rpx;padding:8rpx 18rpx;border-radius:12rpx;background:#F3EADF;border:1rpx solid #EDDFCE;display:flex;align-items:center}
.topic-panel{background:#FFFDF9;border:1rpx solid #E8DDC9;border-radius:24rpx;padding:15rpx 24rpx 22rpx;box-shadow:0 7rpx 18rpx rgba(75,46,20,.035)}.topic-panel .section-head{margin:0 0 10rpx;min-height:61rpx}.topic-panel .section-title{font-size:30rpx}.text-link text{font-size:32rpx;margin-left:10rpx}.group-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16rpx 10rpx}.group-item{text-align:center;padding:10rpx 0 5rpx;display:flex;align-items:center;flex-direction:column}.group-icon{width:77rpx;height:77rpx;border-radius:23rpx;display:flex;align-items:center;justify-content:center}.group-icon image{width:46rpx;height:46rpx}.theme-health{background:#FCE8DD}.theme-safety{background:#E5EDF8}.theme-money{background:#FFF0CF}.theme-rights{background:#EAE7F5}.theme-growth{background:#E9EFDF}.theme-family{background:#F8E4E5}.theme-wellbeing{background:#FBEDD7}.theme-digital{background:#E2EEED}.group-name{font-size:24rpx;font-weight:500;color:#473B30;margin-top:10rpx;line-height:1.4}
.continue{background:#FFFDF9;border:1rpx solid #E8DDC9;border-radius:18rpx;padding:21rpx 23rpx;margin-top:23rpx;display:flex;align-items:center;gap:17rpx}.continue-icon{font-size:34rpx;color:#B96023;background:#FAEDDD;border-radius:15rpx;display:flex;align-items:center;justify-content:center;width:61rpx;height:66rpx;flex-shrink:0}.continue-copy{min-width:0;flex:1}.continue .caption{font-size:21rpx;color:#927B67}.continue-title{font-size:25rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:4rpx;color:#4F4034}.continue-arrow{font-size:35rpx;color:#AF825D}.featured-head{margin-top:33rpx;align-items:flex-start}.featured-head .caption{margin-top:5rpx;font-size:23rpx}.section-mark{color:#99683F;font-size:20rpx;border:1rpx solid #E6CDAE;background:#F8ECDB;padding:5rpx 13rpx;border-radius:9rpx;margin-top:4rpx;white-space:nowrap}
.shelf{display:flex;align-items:center;border-radius:20rpx;background:#F4E6D3;border:1rpx solid #E8D5BB;padding:25rpx;margin-top:23rpx;gap:19rpx}.shelf-icon{width:60rpx;height:68rpx;border-radius:13rpx;background:#FFFDF9;color:#BE6224;display:flex;align-items:center;justify-content:center;font-size:32rpx;box-shadow:0 3rpx 7rpx rgba(91,56,21,.05)}.shelf-copy{flex:1}.shelf-title{font-size:27rpx;font-weight:600;margin-bottom:3rpx}.shelf .caption{font-size:23rpx;color:#8B7259}.shelf-arrow{font-size:38rpx;color:#A97547}