.saved-intro{font-size:25rpx;color:#7D6B5B;margin-top:12rpx}.shelf-stats{display:flex;align-items:center;gap:35rpx;background:#FFFDF9;border:1rpx solid #E8DDC9;border-radius:24rpx;margin-top:27rpx;padding:28rpx 31rpx;box-shadow:0 6rpx 16rpx rgba(76,49,23,.035)}.stat{display:flex;flex-direction:column}.stat-number{font-size:60rpx;font-weight:650;font-variant-numeric:tabular-nums;line-height:1.15;color:#B54D0D}.stat-label{font-size:23rpx;color:#85715E;margin-top:8rpx}.stat-line{height:64rpx;width:1rpx;background:#E6D8C5}.shelf-stamp{font-size:22rpx;line-height:1.55;color:#A66939;margin-left:auto;border:1rpx solid #E8CCA9;border-radius:19rpx;background:#FFF1DC;width:93rpx;height:99rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(5deg);text-align:center}.saved-tabs{display:flex;align-items:center;gap:8rpx;border:1rpx solid #E8DDC9;background:#F1E8DC;border-radius:17rpx;margin:28rpx 0 22rpx;padding:7rpx}.saved-tabs button{color:#84715E;font-size:26rpx;padding:15rpx 20rpx;border-radius:12rpx;flex:1}.saved-tabs .selected{color:#A54B12;background:#FFFDF9;box-shadow:0 3rpx 10rpx rgba(71,46,23,.06);font-weight:600}.saved-tabs .clear-history{font-size:23rpx;flex:0;white-space:nowrap;color:#936A44;padding:15rpx 14rpx}.local-note{display:flex;gap:13rpx;margin-top:30rpx;font-size:23rpx;color:#85705D;line-height:1.9}.local-note text{font-size:22rpx;color:#8D7D6D}.local-dot{width:8rpx;height:8rpx;border-radius:50%;background:#CD9563;flex-shrink:0;margin-top:18rpx}.about-button{font-size:24rpx;color:#A45D25;text-align:left;margin-top:12rpx!important;padding:18rpx 0}