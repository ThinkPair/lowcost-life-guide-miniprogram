.library-intro{font-size:26rpx;color:#7D6B5B;margin:12rpx 0 26rpx}.search-trigger{color:#8B7A6B;font-size:26rpx}.trigger-arrow{margin-left:auto;color:#B5662C;font-size:30rpx}.group-scroll{width:calc(100% + 32rpx);margin-top:25rpx}.group-tabs{display:flex;gap:12rpx;padding-right:32rpx;width:max-content}.group-tab{flex-shrink:0;padding:16rpx 25rpx;border-radius:15rpx;border:1rpx solid #E8DDC9;background:#FFFDF9;color:#7E6C5C;font-size:26rpx;min-height:74rpx}.group-tab.selected{color:#FFFFFF;background:#C2530C;border-color:#C2530C;box-shadow:0 6rpx 12rpx rgba(194,83,12,.13);font-weight:550}.filter-row{display:flex;align-items:center;gap:16rpx;margin-top:23rpx}.chapter-picker{flex:1;min-width:0}.picker-label{display:flex;align-items:center;justify-content:space-between;gap:10rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:18rpx 22rpx;border:1rpx solid #E8DDC9;border-radius:15rpx;font-size:25rpx;background:#FFFDF9;min-height:76rpx}.picker-label text{color:#AE8B6C}.free-filter{padding:18rpx 22rpx;border:1rpx solid #E8DDC9;border-radius:15rpx;font-size:25rpx;color:#85705D;white-space:nowrap;background:#FFFDF9;min-height:76rpx}.free-filter.active{background:#FFF0DC;border-color:#DDB58C;color:#A44810}.evidence-row{display:flex;align-items:center;gap:13rpx;margin-top:17rpx}.evidence-title{font-size:22rpx;color:#887462;margin-right:3rpx}.grade{font-size:24rpx;border:1rpx solid #E8DDC9;border-radius:12rpx;width:68rpx;min-height:68rpx;display:flex;align-items:center;justify-content:center;color:#85715F;background:#FFFDF9}.grade-active{background:#FFF0DC;color:#AA4B12;border-color:#DDB58C;font-weight:600}.grade-help{font-size:22rpx;color:#9B6336;padding:12rpx;margin-left:auto!important;min-height:68rpx;display:flex;align-items:center}.result-head{display:flex;justify-content:space-between;align-items:center;border-top:1rpx solid #E8DDC9;padding-top:23rpx;margin:24rpx 0 18rpx;min-height:55rpx}.result-head button{font-size:23rpx;color:#A65C24;min-height:48rpx}