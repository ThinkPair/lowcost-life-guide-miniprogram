.about .page-title{font-size:43rpx}.about-lead{font-size:28rpx;color:#89715B;line-height:1.85;margin-top:17rpx}.about-card{background:#FFFDF9;border:1rpx solid #E8DDC9;border-radius:22rpx;padding:28rpx;margin-top:23rpx;box-shadow:0 6rpx 16rpx rgba(76,49,23,.025)}.about-copy{display:block;font-size:26rpx;line-height:1.9;white-space:pre-wrap;color:#7A644F;margin-top:19rpx}.about-link{font-size:24rpx;text-align:left;color:#AF5B20;padding:17rpx 0;margin-top:7rpx!important;min-height:72rpx}.grade-row,.principle{display:flex;gap:20rpx;margin-top:24rpx;align-items:flex-start;font-size:26rpx;color:#57432F}.grade-row>text{flex-shrink:0;font-size:30rpx;font-weight:600;color:#B46023;background:#FAEEDD;border-radius:13rpx;width:62rpx;height:62rpx;display:flex;align-items:center;justify-content:center}.grade-row view text,.principle view text{display:block;font-size:24rpx;color:#7D6954;line-height:1.85;margin-top:6rpx}.about-note{font-size:24rpx;background:#FFF1DC;border:1rpx solid #EFD9B8;color:#946A39;padding:20rpx;border-radius:14rpx;margin-top:23rpx;line-height:1.85}.principle>text{font-size:26rpx;color:#BB8A59;font-weight:550}
.glossary-item{font-size:26rpx;line-height:1.9;margin-top:26rpx}.glossary-item view{font-weight:600;color:#40372E;margin-bottom:6rpx}.glossary-item text{color:#75695D}
