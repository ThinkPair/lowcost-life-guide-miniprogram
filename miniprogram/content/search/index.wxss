.search-page .search-box{margin-top:26rpx}.search-start{margin-top:34rpx}.hot-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:22rpx}.hot-grid button{display:flex;justify-content:space-between;align-items:center;border:1rpx solid #E8DDC9;background:#FFFDF9;padding:23rpx 25rpx;border-radius:18rpx;font-size:27rpx;color:#634B37;min-height:92rpx;box-shadow:0 5rpx 12rpx rgba(76,49,23,.025)}.hot-grid text{color:#B86B30;font-size:25rpx}.search-tip{font-size:24rpx;color:#7E6C59;margin-top:28rpx;line-height:1.9}.search-count{font-size:24rpx;color:#8B7056;margin:25rpx 0 21rpx;word-break:break-word}